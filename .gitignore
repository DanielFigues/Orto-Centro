# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist/*
dist-ssr
coverage/
*.tsbuildinfo
*.local
.opencode

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime databases
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.sqlite3
backend/data/*.db

# Runtime import files
backend/import/

# Pre-import database backups
backend/data/backups/

# Runtime user uploads
backend/uploads/
public/uploads/*
!public/uploads/.gitkeep

# The dist folder is a build artifact, but keep the runtime uploads folder
# tracked so it survives a clean deploy/build.
!dist/uploads/
dist/uploads/*
!dist/uploads/.gitkeep

# Keep the runtime data folder tracked even when empty
!backend/data/.gitkeep

# IDE temp / scratch files
*.tmp
*.temp
tmp_*

AGENTS.md
AGENTS.md
